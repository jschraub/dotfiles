destination: hyprland-common/.config/hypr/scripts/keybindings.css
/* Generated by scripts/render_theme.py. */
* { font-family: "CaskaydiaCove Nerd Font", monospace; font-size: 16px; }
window { background-color: {{background}}; border: 2px solid {{accent}}; border-radius: 10px; color: {{text}}; }
#outer-box { padding: 12px; }
#input { margin-bottom: 10px; padding: 10px; background-color: {{raised}}; color: {{text}}; border: none; }
#entry { padding: 6px 10px; }
#entry:selected { background-color: {{hover}}; }
#text { color: {{text}}; }
#entry:selected #text { color: {{accent}}; }
