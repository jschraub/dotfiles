{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6.1-sol",
  "small_model": "openai/gpt-5.6-luna",
  "default_agent": "default",
  "share": "disabled",
  "autoupdate": "notify",
  "instructions": ["/home/jars/.config/opencode/AGENTS.md"],
  "agent": {
    "default": {
      "model": "openai/gpt-6.1-sol",
      "variant": "medium",
      "mode": "primary"
    },
    "build": {
      "model": "openai/gpt-5.6-sol",
      "variant": "medium"
    },
    "plan": {
      "model": "openai/gpt-6-astra",
      "variant": "medium"
    },
    "general": {
      "model": "openai/gpt-5.6-luna",
      "variant": "high"
    },
    "explore": {
      "model": "openai/gpt-5.6-luna",
      "variant": "high"
    }
  },
  "mcp": {
    "cloudflare": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp"
    }
  },
  // OpenCode Quota: tuiCommandDisplay chooses whether native TUI command output appears in the session transcript or a local popup dialog.
  // OpenCode Quota: one V2 entry loads both server and TUI parts.
  "plugins": [
    "@slkiser/opencode-quota@5"
  ],
  "provider": {
    // Detected openai authentication; opencode-quota added this global provider declaration.
    "openai": {}
  }
}
