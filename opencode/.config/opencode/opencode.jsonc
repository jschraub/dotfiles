{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-terra",
  "small_model": "openai/gpt-5.6-luna",
  "share": "disabled",
  "autoupdate": "notify",
  "agent": {
    "build": {
      "model": "openai/gpt-5.6-terra",
      "variant": "high"
    },
    "plan": {
      "model": "openai/gpt-5.6-terra",
      "variant": "high"
    },
    "general": {
      "model": "openai/gpt-5.6-luna",
      "variant": "high"
    },
    "explore": {
      "model": "openai/gpt-5.6-luna",
      "variant": "high"
    }
  },
  "mcp": {
    "cloudflare": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp"
    }
  }
}
