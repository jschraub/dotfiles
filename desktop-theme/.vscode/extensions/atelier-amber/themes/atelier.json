  "tokenColors": [
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#858585"
      }
    },
    {
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#e87524"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#65c18c"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#e5a120"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#e5a120"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type"
      ],
      "settings": {
        "foreground": "#70a8cf"
      }
    },
    {
      "scope": [
        "variable",
        "punctuation"
      ],
      "settings": {
        "foreground": "#e6e6e6"
