#!/usr/bin/env python3
"""Use the shared keyring tooling from its Stow-owned implementation."""
from pathlib import Path
import runpy
import sys

sys.dont_write_bytecode = True
library = Path(__file__).resolve().parents[1] / 'lib/atelier-keyring'
sys.path.insert(0, str(library))
runpy.run_path(str(library / 'main.py'), run_name='__main__')
