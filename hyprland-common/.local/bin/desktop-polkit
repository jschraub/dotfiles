#!/usr/bin/env python3
"""Supervise only Atelier's native agent; no alternate UI or credential handling."""
import fcntl
import os
from pathlib import Path
import signal
import subprocess
import sys
import time

CONFIG = Path(os.environ.get('XDG_CONFIG_HOME') or Path.home() / '.config')
RUNTIME = Path(os.environ.get('XDG_RUNTIME_DIR') or f'/run/user/{os.getuid()}')
QS = os.environ.get('ATELIER_QS_BINARY', 'qs')
AUTH = str(CONFIG / 'quickshell/atelier/auth.qml')


def ready():
    try:
        result = subprocess.run([QS, 'ipc', '-p', AUTH, 'call', 'auth', 'health'],
                                capture_output=True, text=True, timeout=1)
        return result.returncode == 0 and result.stdout.strip() == 'ready'
    except (OSError, subprocess.SubprocessError):
        return False


def run_agent():
    """Restart failed/unregistered agents; never authorize when unavailable."""
    child = subprocess.Popen([QS, '-p', AUTH, '--no-duplicate'], stdin=subprocess.DEVNULL)
    try:
        misses = 0
        while child.poll() is None:
            try:
                child.wait(timeout=2)
            except subprocess.TimeoutExpired:
                misses = 0 if ready() else misses + 1
                if misses >= 5:
                    print('Atelier authentication registration lost; restarting native agent.', file=sys.stderr)
                    return
    finally:
        if child.poll() is None:
            child.terminate()
            try:
                child.wait(timeout=5)
            except subprocess.TimeoutExpired:
                child.kill()
                child.wait()


def supervise():
    with (RUNTIME / 'dotfiles-polkit.lock').open('w') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return
        def stop(signum, frame):
            raise SystemExit(0)
        signal.signal(signal.SIGTERM, stop)
        signal.signal(signal.SIGINT, stop)
        while True:
            try:
                run_agent()
            except (OSError, subprocess.SubprocessError) as error:
                print(f'Atelier authentication agent unavailable: {type(error).__name__}', file=sys.stderr)
            time.sleep(2)


def activate():
    if ready():
        return 0
    with (RUNTIME / 'dotfiles-polkit.log').open('a') as log:
        subprocess.Popen([sys.executable, '-B', str(Path(__file__).resolve()), 'start'],
                         stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
    deadline = time.monotonic() + 12
    while time.monotonic() < deadline:
        if ready():
            return 0
        time.sleep(.1)
    print('Atelier authentication unavailable; inspect dotfiles-polkit.log. Native retries continue.', file=sys.stderr)
    return 1


if __name__ == '__main__':
    command = sys.argv[1] if len(sys.argv) > 1 else 'start'
    if command == 'start':
        supervise()
    elif command == 'activate':
        raise SystemExit(activate())
    else:
        raise SystemExit('Usage: desktop-polkit start|activate')
