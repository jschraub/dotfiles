#!/usr/bin/env python3
"""Start the root-installed native lock. No unlock/password IPC or test bypass."""
import fcntl
import os
from pathlib import Path
import stat
import subprocess
import sys
import time

CONFIG = Path('/etc/atelier/access/lock.qml')


def trusted(path):
    for item in (path, *path.parents):
        metadata = item.lstat()
        if stat.S_ISLNK(metadata.st_mode) or metadata.st_uid != 0 or metadata.st_mode & 0o022:
            raise ValueError(f'Authentication asset is not root-owned/read-only: {item}')


def main():
    if sys.argv[1:] not in ([], ['--test']):
        raise SystemExit('Usage: desktop-lock [--test] (--test is a REAL password-only session lock)')
    if not os.environ.get('WAYLAND_DISPLAY') or not os.environ.get('XDG_RUNTIME_DIR'):
        raise ValueError('Start the lock from inside the Wayland session')
    trusted(CONFIG)
    trusted(Path('/etc/pam.d/atelier-lock'))
    runtime = Path(os.environ['XDG_RUNTIME_DIR'])
    with (runtime / 'dotfiles-atelier-lock.lock').open('w') as lock:
        deadline = time.monotonic() + 12
        while True:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                status = subprocess.run(['qs', 'ipc', '-p', str(CONFIG), 'call', 'lock', 'secure'],
                                        capture_output=True, text=True, timeout=1)
                if status.returncode == 0 and status.stdout.strip() == 'true':
                    return 1 if sys.argv[1:] == ['--test'] else 0
                if time.monotonic() >= deadline:
                    raise ValueError('Authentication UI is being updated or the locker is not ready; lock request failed')
                time.sleep(.1)
        # Never start a second locker over an existing Hyprlock instance.
        if subprocess.run(['pgrep', '-u', str(os.getuid()), '-x', 'hyprlock'], capture_output=True).returncode == 0:
            return 1 if sys.argv[1:] == ['--test'] else 0
        config_home = Path(os.environ.get('XDG_CONFIG_HOME') or Path.home() / '.config')
        helper = config_home / 'hypr/scripts/lock.sh'
        policy = subprocess.run([str(helper), '--check'], capture_output=True, text=True, timeout=4)
        # The wizard's real password test must not succeed via a fingerprint.
        fingerprint = sys.argv[1:] != ['--test'] and policy.returncode == 0 and 'fingerprint=true' in policy.stdout
        if fingerprint:
            trusted(Path('/etc/pam.d/atelier-fingerprint'))
        environment = dict(os.environ, ATELIER_FINGERPRINT='1' if fingerprint else '0')
        with (runtime / 'dotfiles-atelier-lock.log').open('a') as log:
            child = subprocess.Popen(['qs', '-p', str(CONFIG), '--no-duplicate'], env=environment,
                                     stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT)
            deadline = time.monotonic() + 10
            secured = False
            while child.poll() is None and time.monotonic() < deadline:
                status = subprocess.run(['qs', 'ipc', '-p', str(CONFIG), 'call', 'lock', 'secure'],
                                        capture_output=True, text=True, timeout=1)
                if status.returncode == 0 and status.stdout.strip() == 'true':
                    secured = True
                    break
                time.sleep(.05)
            if not secured:
                print('Native lock did not acknowledge secure coverage. Inspect dotfiles-atelier-lock.log.', file=sys.stderr)
                # Do not attempt an unlock: a crashed lock must remain fail-closed.
                if child.poll() is None:
                    child.terminate()
                child.wait(timeout=5)
                return 1
            return child.wait()


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print(f'Cannot start Atelier lock: {error}', file=sys.stderr)
        raise SystemExit(1)
