#!/usr/bin/env bash
# Atelier is the sole desktop UI. Failed startup is explicit, never legacy.
set -euo pipefail
config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
qs="${ATELIER_QS_BINARY:-qs}"
runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

start_atelier() (
    exec 9>"$runtime/dotfiles-desktop-shell.lock"
    flock 9
    command -v "$qs" >/dev/null || { echo 'Install Quickshell: ./setup.sh quickshell' >&2; exit 1; }
    [[ -f "$config_home/quickshell/atelier/shell.qml" ]] || { echo 'Restow the quickshell package first' >&2; exit 1; }
    if [[ "$("$qs" ipc -c atelier call shell health 2>/dev/null || true)" != ready ]]; then
        # Clear a failed/test/preview instance, but never restart a healthy shell.
        "$qs" kill -c atelier >/dev/null 2>&1 || true
        env -u ATELIER_PREVIEW -u ATELIER_TEST "$qs" -c atelier --no-duplicate --daemonize 9>&-
    fi
    for ((attempt=0; attempt<50; attempt++)); do
        if [[ "$("$qs" ipc -c atelier call shell health 2>/dev/null || true)" == ready ]]; then
            if busctl --user --auto-start=no --timeout=1 call org.freedesktop.Notifications \
                /org/freedesktop/Notifications org.freedesktop.Notifications GetServerInformation 2>/dev/null | grep -qi quickshell; then
                exit 0
            fi
        fi
        sleep 0.2
    done
    echo 'Atelier did not become ready or acquire notifications. Inspect qs log -c atelier.' >&2
    exit 1
)

case "${1:-start}" in
    mode) echo quickshell ;;
    start|activate) start_atelier ;;
    preview)
        if "$qs" ipc -c atelier call shell health >/dev/null 2>&1; then
            echo 'Atelier is already running; preview must not replace the live desktop.' >&2
            exit 1
        fi
        ATELIER_PREVIEW=1 "$qs" -c atelier --no-duplicate
        ;;
    toggle)
        panel="${2:-launcher}"
        case "$panel" in
            launcher|bindings|power|audio|audioDevices|bluetooth|media|tray|network|calendar|notifications|clipboard) ;;
            *) echo "Unknown Atelier panel: $panel" >&2; exit 2 ;;
        esac
        if ! "$qs" ipc -c atelier call shell toggle "$panel"; then
            start_atelier
            "$qs" ipc -c atelier call shell toggle "$panel"
        fi
        ;;
    *) echo 'Usage: desktop-shell start|activate|preview|mode|toggle PANEL' >&2; exit 2 ;;
esac
